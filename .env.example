# Copy to .env (git-ignored) and adjust. Every setting is documented in docs/ENGINEERING.md.

# --- LLM (free Gemini key: https://aistudio.google.com -> Get API key) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
# gemini | mock  (mock = offline dictionary, no key needed)
LLM_PROVIDER=gemini

# --- Security ---
# Required in production (>= 32 random characters), e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# SECRET_KEY=
# development | production. Production refuses to start with the dev secret or with demo data.
# ENVIRONMENT=development
# ALLOW_REGISTRATION=true        # "Create account" on the login page (new accounts are translators); false = admins create users
# SEED_DEMO_DATA=true            # demo users (admin/admin123, ...) + sample glossary; MUST be false in production
# BOOTSTRAP_ADMIN_USERNAME=      # production: first administrator, created only when no user exists
# BOOTSTRAP_ADMIN_PASSWORD=

# --- Operations ---
# MAX_UPLOAD_MB=20
# LOG_FORMAT=text                # json for log collectors
# LOG_LEVEL=INFO
# ENABLE_HSTS=false              # true when served over HTTPS
# DOCS_ENABLED=true              # Swagger UI at /docs
# AUTO_MIGRATE=true              # false when migrations run as a separate deploy step (python -m app.migrate)
