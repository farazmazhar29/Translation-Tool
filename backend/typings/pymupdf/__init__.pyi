from collections.abc import Iterator
from os import PathLike
from types import TracebackType
from typing import Literal, overload

class Page:
    @overload
    def get_text(self, option: Literal["blocks"]) -> list[tuple[float, float, float, float, str, int, int]]: ...
    @overload
    def get_text(self, option: Literal["text"] = "text") -> str: ...

class Document:
    def __enter__(self) -> Document: ...
    def __exit__(self, *a: type[BaseException] | BaseException | TracebackType | None) -> None: ...
    def __iter__(self) -> Iterator[Page]: ...
    def __len__(self) -> int: ...

def open(
    filename: str | PathLike[str] | None = None, *, stream: bytes | None = None, filetype: str | None = None
) -> Document: ...
