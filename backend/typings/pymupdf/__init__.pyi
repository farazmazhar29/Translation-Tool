from collections.abc import Iterator
from os import PathLike
from types import TracebackType

class Page:
    def get_text(self, option: str) -> list[tuple[float, float, float, float, str, int, int]]: ...

class Document:
    def __enter__(self) -> Document: ...
    def __exit__(self, *a: type[BaseException] | BaseException | TracebackType | None) -> None: ...
    def __iter__(self) -> Iterator[Page]: ...
    def __len__(self) -> int: ...

def open(filename: str | PathLike[str]) -> Document: ...
